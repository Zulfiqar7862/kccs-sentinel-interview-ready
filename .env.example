# Copy to .env (never commit .env). Every setting has a safe default; no secrets or API keys are needed.
# The kernel never calls a language model or any external API.

# Where the confidential workbook lives (kept out of git; see .gitignore)
KCCS_WORKBOOK=data/KCCS_Sentinel_Reference_Data_Pack.xlsx
KCCS_DATA_DIR=data
# Load the workbook automatically when the API starts (idempotent)
KCCS_AUTOLOAD=true

# Append-only SQLite store and exported evidence packages
KCCS_DB_PATH=artifacts/api/kernel.sqlite
KCCS_ARTIFACTS_DIR=artifacts/api

# HTTP server
KCCS_HOST=127.0.0.1
KCCS_PORT=8000

# json (for log shipping) or text (for a terminal)
KCCS_LOG_FORMAT=json
KCCS_LOG_LEVEL=INFO

# Demo-only endpoints (package tamper demo). Set false outside a demo.
KCCS_DEMO_ENDPOINTS=true

# Optional fixed clock for reproducible demos, e.g. 2026-11-08T12:00:00Z (blank = real time)
KCCS_FIXED_NOW=
